# Builds Super from the sources (the release image, Dockerfile, takes the binary built by the
# release workflow), against the image's glibc: musl's allocator serves one thread at a time
FROM node:24-alpine AS ui
WORKDIR /ui
COPY crates/super_admin_ui/package.json crates/super_admin_ui/package-lock.json ./
RUN npm ci
COPY crates/super_admin_ui/ ./
RUN npm run build

# OpenSSL is built from source (vendored), with the image's perl and make
FROM rust:1.99-trixie AS build
WORKDIR /src
COPY . .
COPY --from=ui /ui/dist crates/super_admin_ui/dist
RUN cargo build --release --locked -p super_proxy && cp target/release/super /super

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y ca-certificates && apt-get clean

COPY --from=build /super /app/super

WORKDIR /app

# 443/udp: HTTP/3, when `server.http3` is on
EXPOSE 80 443 443/udp

ENTRYPOINT ["/app/super"]
